rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.uid == 'NdoyBz3UMcWGWQ3DhuwrIbVbZvl2';
    }
    // Keep existing posts readable and accept the current Uploadcare delivery host.
    function validImage(url) {
      return url is string && (
        url.matches('^https://ucarecdn\\.com/[a-f0-9-]{20,40}/$') ||
        url.matches('^https://26vsxjozef\\.ucarecd\\.net/[a-f0-9-]{20,40}/$')
      );
    }

    // Blocks prevent new likes/comments as well as new follows.
    // Public post reads remain available to signed-in users; blocked accounts
    // are hidden in the normal app interface.
    function canInteractWithPost(postId) {
      let authorUid = get(
        /databases/$(database)/documents/posts/$(postId)
      ).data.uid;
      return !exists(
        /databases/$(database)/documents/blocks/$(authorUid)/users/$(request.auth.uid)
      ) && !exists(
        /databases/$(database)/documents/blocks/$(request.auth.uid)/users/$(authorUid)
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'platform', 'platforms', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{2,20}$')
        && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC']
        && request.resource.data.platforms is list
        && request.resource.data.platforms.size() >= 1
        && request.resource.data.platforms.size() <= 3
        && request.resource.data.platform in request.resource.data.platforms
        && request.resource.data.platforms.hasOnly(['PlayStation', 'Xbox', 'PC'])
        && request.resource.data.createdAt is int;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'platform', 'platforms', 'avatarUrl', 'avatarStoragePath'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{2,20}$')
        && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC']
        && request.resource.data.platforms is list
        && request.resource.data.platforms.size() >= 1
        && request.resource.data.platforms.size() <= 3
        && request.resource.data.platform in request.resource.data.platforms
        && request.resource.data.platforms.hasOnly(['PlayStation', 'Xbox', 'PC'])
        && (!('avatarUrl' in request.resource.data) || validImage(request.resource.data.avatarUrl))
        && (!('avatarStoragePath' in request.resource.data) ||
          (request.resource.data.avatarStoragePath is string &&
           request.resource.data.avatarStoragePath.matches('^uploadcare/[a-f0-9-]{20,40}$')));
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // A unique server-verified UTC day per player prevents repeated check-ins.
      // The day identifier is YEAR-DAY_OF_YEAR, e.g. 2026-311.
      // Signed-in players can read attendance to display public activity ranks.
      match /checkins/{dayId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(uid))
          && dayId == string(request.time.year()) + '-' +
            string(request.time.dayOfYear())
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        // Cleanup can happen only after the account's user document is deleted.
        allow delete: if signedIn()
          && request.auth.uid == uid
          && !exists(/databases/$(database)/documents/users/$(uid));
      }

      // Private personal game library.
      match /library/{gameId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'platform', 'status', 'createdAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 80
          && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC']
          && request.resource.data.status in ['backlog', 'playing', 'completed']
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['backlog', 'playing', 'completed'];
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Personal bookmarks, invisible to other accounts.
    match /savedPosts/{ownerUid}/items/{postId} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow create: if signedIn()
        && request.auth.uid == ownerUid
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.keys().hasOnly(['uid', 'postId', 'createdAt'])
        && request.resource.data.uid == ownerUid
        && request.resource.data.postId == postId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }

    // Account-level block list. Owner can remove follow relationships.
    match /blocks/{ownerUid}/users/{blockedUid} {
      allow read: if signedIn() && request.auth.uid == ownerUid;
      allow create: if signedIn()
        && request.auth.uid == ownerUid
        && ownerUid != blockedUid
        && exists(/databases/$(database)/documents/users/$(blockedUid))
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'blockedUid', 'createdAt'
        ])
        && request.resource.data.ownerUid == ownerUid
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }

    // A single document per follower/target pair prevents duplicate follows.
    // Count followers/following with Firestore count queries; no editable counters.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerUid', 'targetUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && !exists(
          /databases/$(database)/documents/blocks/$(request.auth.uid)/users/$(request.resource.data.targetUid)
        )
        && !exists(
          /databases/$(database)/documents/blocks/$(request.resource.data.targetUid)/users/$(request.auth.uid)
        )
        && followId == request.auth.uid + '_' + request.resource.data.targetUid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // You can unfollow, or remove someone who follows your own profile.
      allow delete: if signedIn() && (
        isAdmin() || resource.data.followerUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'platform', 'gameName', 'title', 'completion', 'rating', 'imageUrl',
          'storagePath', 'pros', 'cons', 'platinum', 'createdAt',
          'likes', 'commentCount'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.platform in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platforms
        && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC']
        && request.resource.data.gameName is string
        && request.resource.data.gameName.size() > 0
        && request.resource.data.gameName.size() <= 80
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 100
        && request.resource.data.completion is int
        && request.resource.data.completion >= 0
        && request.resource.data.completion <= 100
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && validImage(request.resource.data.imageUrl)
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^uploadcare/[a-f0-9-]{20,40}$')
        && request.resource.data.pros is string
        && request.resource.data.pros.size() >= 5
        && request.resource.data.pros.size() <= 500
        && request.resource.data.cons is string
        && request.resource.data.cons.size() >= 5
        && request.resource.data.cons.size() <= 500
        && request.resource.data.platinum is bool
        && (
          request.resource.data.platinum == false ||
          (
            request.resource.data.platform == 'PlayStation' &&
            request.resource.data.completion == 100
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes == 0
        && request.resource.data.commentCount == 0;
      allow update: if false;
      allow delete: if signedIn()
        && (isAdmin() || resource.data.uid == request.auth.uid);

      match /likes/{likerUid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == likerUid
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canInteractWithPost(postId)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (
          isAdmin() || request.auth.uid == likerUid ||
          (exists(/databases/$(database)/documents/posts/$(postId)) &&
           get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid)
        );
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && canInteractWithPost(postId)
          && request.resource.data.keys().hasOnly(['uid', 'username', 'text', 'createdAt', 'replyTo'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && (!('replyTo' in request.resource.data) ||
              (request.resource.data.replyTo is string &&
               exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.replyTo))))
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (
          isAdmin() || resource.data.uid == request.auth.uid ||
          (exists(/databases/$(database)/documents/posts/$(postId)) &&
           get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid)
        );
      }
    }

    match /stories/{storyId} {
      // Old stories are filtered by expiresAt on the client; Firestore security rules
      // cannot safely compare a client Timestamp.now() query bound to request.time.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'imageUrl', 'caption', 'createdAt', 'expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && validImage(request.resource.data.imageUrl)
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 180
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(26, 'h');
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // User requests for removal of third-party Uploadcare files.
    // The account deletion flow removes Firestore content and Firebase Auth;
    // media must subsequently be purged with trusted Uploadcare credentials.
    match /deletionRequests/{deletionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'imagePaths', 'createdAt', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.imagePaths is list
        && request.resource.data.imagePaths.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Players may report inappropriate stories; only the owner reviews reports.
    // Beta tester feedback: authenticated users can submit, only the owner reads.
    // Future Play Billing entitlement cache. Only a trusted server using
    // Firebase Admin SDK may write this collection after purchase verification.
    // Never let Android client code grant itself subscriptions or privileges.
    match /entitlements/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'type', 'text', 'status', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['bug', 'idea', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }

    match /storyReports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'storyId', 'storyOwnerUid', 'reporterUid',
          'reason', 'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.storyId is string
        && exists(/databases/$(database)/documents/stories/$(request.resource.data.storyId))
        && request.resource.data.storyOwnerUid ==
          get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)).data.uid
        && request.resource.data.storyOwnerUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'postId', 'postOwnerUid', 'reporterUid', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && request.resource.data.postOwnerUid == get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.uid
        && request.resource.data.postOwnerUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['reviewed', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if isAdmin();
    }
  }
}
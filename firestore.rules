rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      // Profiles are public in Phase 1; private account data must live in a separate collection.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'platform', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9]{2,20}$')
        && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC'];
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      // Posts are created only by the trusted createPost Cloud Function (Admin SDK).
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}

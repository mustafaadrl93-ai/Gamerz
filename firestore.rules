rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'platform', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{2,20}$')
        && request.resource.data.platform in ['PlayStation', 'Xbox', 'PC'];
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username']);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      // Creation and deletion go through authenticated Cloud Functions.
      allow create, update, delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && resource.data.expiresAt > request.time;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }
  }
}